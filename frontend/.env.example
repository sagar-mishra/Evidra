# Frontend environment
# Copy to .env.local:
#   copy .env.example .env.local

# FastAPI backend origin (browser calls this URL)
# Windows: use 127.0.0.1 not localhost (avoids WSL/Docker IPv6 hijack on :8000)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Admin portal credentials (server-side only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# App users CSV
# Local: defaults to ./data/users.csv
# Deployed: set AZURE_STORAGE_CONNECTION_STRING so all instances share one users.csv blob
# USERS_CSV_PATH=./data/users.csv
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# USERS_CSV_CONTAINER=evidra-auth
# USERS_CSV_BLOB=users.csv

# Azure example:
# NEXT_PUBLIC_API_URL=https://ca-release-assurance-api.<region>.azurecontainerapps.io
