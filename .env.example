# =============================================================================
# Industrial Controls Release Assurance — monorepo env template
# Copy to `.env` in the project root:
#   copy .env.example .env
# =============================================================================

# --- API Keys ---
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key
# Voyage embeddings (Anthropic-recommended partner — NOT the Claude key)
# Sign up + key: https://dash.voyageai.com/
# Docs: https://platform.claude.com/docs/en/build-with-claude/embeddings
VOYAGE_API_KEY=pa-your-voyage-api-key
OPENAI_API_KEY=sk-proj-your-openai-key
GEMINI_API_KEY=AIzaSy-your-gemini-key

# --- Vector & Embedding Config ---
# Anthropic has no native embeddings API. Use Voyage voyage-4-lite with Claude:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL_NAME=voyage-4-lite
# EMBEDDING_DIMENSIONS=1024

# Alternatives:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL_NAME=text-embedding-3-small
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL_NAME=gemini-embedding-001
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- LLM Config (Defaulting to Anthropic Priority) ---
LLM_PROVIDER=anthropic
LLM_MODEL_NAME=anthropic/claude-3-5-haiku-20241022
LLM_REASONING_MODEL=anthropic/claude-3-5-sonnet-20240620

# OpenAI example:
# LLM_PROVIDER=openai
# LLM_MODEL_NAME=gpt-4o-mini
# LLM_REASONING_MODEL=gpt-4o

# --- Qdrant extras ---
QDRANT_IN_MEMORY=false
QDRANT_TIMEOUT=120
QDRANT_UPSERT_BATCH_SIZE=16
QDRANT_UPSERT_RETRIES=4

# Optional
# LLM_API_BASE=
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=2048
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Azure deploy
#   powershell -ExecutionPolicy Bypass -File .\scripts\deploy-azure.ps1
# -----------------------------------------------------------------------------
